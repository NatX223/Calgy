rules_version = '2';

// Production rules. users/{uid} is written only by the API (Admin SDK bypasses rules);
// clients read it and read/write their own log collections (offline-first). pushSubscriptions and
// aggregates are written only by the API; signed-in users may read aggregates.
service cloud.firestore {
  match /databases/{database}/documents {
    function isOwner(uid) {
      return request.auth != null && request.auth.uid == uid;
    }
    function isLogCollection(coll) {
      return coll in ['devices', 'meterReadings', 'tokenLoads', 'fuelPurchases', 'generators'];
    }
    // Every write stamps updatedAt with the server time and keeps doc ID == clientId.
    function validLogWrite(docId) {
      let d = request.resource.data;
      return d.clientId == docId
        && d.updatedAt == request.time
        && d.createdAt is timestamp
        && d.size() <= 40;
    }
    // Cheap sanity checks; full validation is zod on the client (and the API never trusts logs).
    function validLogValues(coll) {
      let d = request.resource.data;
      return (coll != 'tokenLoads' || (d.amountNaira is number && d.amountNaira > 0))
        && (coll != 'fuelPurchases' || (d.amountNaira is number && d.amountNaira > 0
              && (d.get('litres', null) == null || (d.litres is number && d.litres > 0))))
        && (coll != 'meterReadings' || (d.unitsLeft is number && d.unitsLeft >= 0 && d.unitsLeft <= 100000));
    }

    match /users/{uid} {
      allow read: if isOwner(uid);
      allow write: if false;

      match /{coll}/{docId} {
        allow read: if isOwner(uid) && isLogCollection(coll);
        allow create, update: if isOwner(uid) && isLogCollection(coll) && validLogWrite(docId) && validLogValues(coll);
        allow delete: if isOwner(uid) && isLogCollection(coll);
      }

      // Backend only (also covered by isLogCollection above; explicit so it can't be opened by accident).
      match /pushSubscriptions/{id} {
        allow read, write: if false;
      }
    }

    match /aggregates/{id} {
      allow read: if request.auth != null;
      allow write: if false;
    }
  }
}
