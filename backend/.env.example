# Local dev: copy to backend/.env (gitignored). Production: /etc/calgy/api.env on the VM (see DEPLOY.md).
NODE_ENV=development

# 'bearer' (default): Firebase ID token in Authorization. 'cookie' only once app + API share a custom domain.
AUTH_MODE=bearer
# Never bind publicly; Caddy proxies. 4000 locally because the Firestore emulator uses 8080.
HOST=127.0.0.1
PORT=4000

# Comma-separated, exact origins (no trailing slash).
APP_ORIGINS=http://localhost:3000
ALLOW_VERCEL_PREVIEWS=false
# Regex for preview origins (anchored for you), used only if ALLOW_VERCEL_PREVIEWS=true.
VERCEL_PREVIEW_PATTERN=

# Service account key, base64-encoded on one line. Firebase console → Project settings → Service accounts →
# Generate new private key, then: base64 -w0 service-account.json  (PowerShell:
# [Convert]::ToBase64String([IO.File]::ReadAllBytes("service-account.json"))). Never commit it.
CRED=
# Optional: defaults to project_id inside CRED (must match it if set).
FIREBASE_PROJECT_ID=
# Or run against the emulators instead (no CRED needed): FIREBASE_PROJECT_ID=demo-calgy and
# FIRESTORE_EMULATOR_HOST=127.0.0.1:8080
# FIREBASE_AUTH_EMULATOR_HOST=127.0.0.1:9099

# Generate ONCE with `npx web-push generate-vapid-keys`. Regenerating breaks every existing subscription.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:you@example.com

# Smallest number of users behind any published aggregate bucket.
AGGREGATE_MIN_CONTRIBUTORS=10
# true = no cron jobs in this process (local dev, or a second instance).
DISABLE_JOBS=true
LOG_LEVEL=info

# Cookie mode only
COOKIE_DOMAIN=
SESSION_DAYS=14
