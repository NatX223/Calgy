{
  "name": "backend",
  "version": "0.1.0",
  "scripts": {
    "dev": "tsx watch --env-file-if-exists=.env src/index.ts",
    "build": "node build.mjs",
    "start": "node --enable-source-maps --env-file-if-exists=.env dist/index.js",
    "typecheck": "tsc --noEmit",
    "test": "node --import tsx --test test/*.test.ts",
    "test:emulator": "npx -y firebase-tools@latest emulators:exec --config ../firebase.json --only auth,firestore --project demo-calgy \"node --import tsx --test test/emulator/*.test.ts\""
  },
  "dependencies": {
    "@calgy/engine": "^0.1.0",
    "@calgy/shared": "^0.1.0",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.6",
    "express": "^5.3.0",
    "express-rate-limit": "^8.7.1",
    "firebase-admin": "^14.5.0",
    "helmet": "^8.3.0",
    "node-cron": "^4.6.0",
    "pino": "^10.4.0",
    "web-push": "^3.6.7",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/cookie-parser": "^1.4.10",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/node": "^22.20.5",
    "@types/web-push": "^3.6.4",
    "esbuild": "^0.28.2",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2"
  },
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22"
  }
}
